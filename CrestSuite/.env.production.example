# Copy to .env on the server and fill in. Never commit the filled-in file.
#
# Generate each secret with:  openssl rand -hex 32

# ---- public address ----
# Domain that points at this server. Caddy issues TLS for it automatically.
# Use ":80" instead for plain HTTP if you have no domain yet.
SITE_ADDRESS=crestsuite.example.com
PUBLIC_URL=https://crestsuite.example.com

# ---- database (stays inside the compose network) ----
POSTGRES_USER=clockit
POSTGRES_PASSWORD=clockit
POSTGRES_DB=clockit

# ---- secrets ----
JWT_SECRET=
PORTAL_SECRET=
LEAVEMS_JWT_SECRET=
QMS_SECRET=

# ---- outbound mail (password resets, invitations) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
